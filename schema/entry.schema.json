{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leeds diocesan calendar record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "dateRule",
    "rank",
    "status",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dateRule": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable pending Romcal rule mapping"
    },
    "rank": {
      "enum": [
        "solemnity",
        "feast",
        "memorial",
        "optional_memorial"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "year",
        "reference"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
